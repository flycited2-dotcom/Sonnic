{
  "$defs": {
    "DreamInput": {
      "additionalProperties": false,
      "properties": {
        "dream_text": {
          "maxLength": 10000,
          "minLength": 20,
          "title": "Dream Text",
          "type": "string"
        },
        "wake_emotion": {
          "default": "",
          "maxLength": 120,
          "title": "Wake Emotion",
          "type": "string"
        },
        "dream_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dream Date"
        },
        "recurring": {
          "default": false,
          "title": "Recurring",
          "type": "boolean"
        },
        "locale": {
          "default": "ru-RU",
          "enum": [
            "ru-RU",
            "en-US"
          ],
          "title": "Locale",
          "type": "string"
        },
        "content_language": {
          "default": "und",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "title": "Content Language",
          "type": "string"
        },
        "recognition_locale": {
          "anyOf": [
            {
              "maxLength": 35,
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognition Locale"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "cultural_perspective": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cultural Perspective"
        }
      },
      "required": [
        "dream_text"
      ],
      "title": "DreamInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "sonnic-project-v1",
      "default": "sonnic-project-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "knowledge_version": {
      "const": "knowledge-v1",
      "default": "knowledge-v1",
      "title": "Knowledge Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "data_class": {
      "const": "synthetic",
      "default": "synthetic",
      "title": "Data Class",
      "type": "string"
    },
    "output_locale": {
      "enum": [
        "ru-RU",
        "en-US"
      ],
      "title": "Output Locale",
      "type": "string"
    },
    "dream": {
      "$ref": "#/$defs/DreamInput"
    }
  },
  "required": [
    "job_id",
    "lease_id",
    "attempt",
    "input_sha256",
    "output_locale",
    "dream"
  ],
  "title": "JobInput",
  "type": "object"
}
