# Demo makes no AI requests. Real mode requires every setting below and a restart.
AI_MODE=demo
SONNIC_DB_PATH=data/sonnic.sqlite3
AI_ALLOW_PAID_REQUESTS=false
# Keep secrets server-only. Never use NEXT_PUBLIC_* for a key.
OPENAI_API_KEY=
# Explicit Responses + Structured Outputs compatible model IDs available to your API project.
OPENAI_EXTRACT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_FREE_MODEL=gpt-5.4-mini-2026-03-17
